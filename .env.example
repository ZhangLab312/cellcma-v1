# LLM API Configuration - LLM API配置
# Copy this file to .env and fill in your actual values

# Provider selection: openai, anthropic, azure, local, custom
LLM_PROVIDER=openai

# Base URL for the API
# OpenAI: https://api.openai.com/v1
# Anthropic: https://api.anthropic.com/v1
# Local (vLLM/Ollama): http://localhost:8000/v1 or http://localhost:11434/v1
# Custom: your custom endpoint
LLM_BASE_URL=https://api.openai.com/v1

# API Key
# For OpenAI: your OpenAI API key
# For Anthropic: your Anthropic API key
# For Local: usually not needed, can be any string
# For Azure: your Azure API key
LLM_API_KEY=your-api-key-here

# Model name
# OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
# Local: depends on your local model
LLM_MODEL=gpt-4

# Optional parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ============================================
# Example configurations for different providers
# ============================================

# --- OpenAI Example ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4

# --- Anthropic Example ---
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=claude-3-sonnet-20240229

# --- vLLM Local Example ---
# LLM_PROVIDER=local
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=local-model

# --- Ollama Local Example ---
# LLM_PROVIDER=local
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=llama2

# --- Azure OpenAI Example ---
# LLM_PROVIDER=azure
# LLM_BASE_URL=https://your-resource.openai.azure.com
# LLM_API_KEY=your-azure-key
# LLM_MODEL=your-deployment-name

# ============================================
# Model Switching in Code - 代码中切换模型
# ============================================
# You can also switch models programmatically without changing .env:
#
# from Agent.llm import LLMConfig
#
# # Create base config
# config = LLMConfig.from_env()  # or LLMConfig.openai(api_key="...")
#
# # Switch to a different model (same provider)
# cheap_config = config.with_model("gpt-3.5-turbo")
# vision_config = config.with_model("gpt-4-vision-preview")
#
# # Or use convenient class methods
# gpt4_config = LLMConfig.openai_gpt4(api_key="...")
# gpt35_config = LLMConfig.openai_gpt35(api_key="...")
# opus_config = LLMConfig.anthropic_opus(api_key="...")
# sonnet_config = LLMConfig.anthropic_sonnet(api_key="...")
# haiku_config = LLMConfig.anthropic_haiku(api_key="...")
#
# # Use different models for different agents (cost optimization)
# actor_config = LLMConfig.openai_gpt4(api_key="...")      # Complex reasoning
# evaluator_config = actor_config.with_model("gpt-3.5-turbo")  # Simple assessment
